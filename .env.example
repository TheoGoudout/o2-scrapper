# Copy to .env and fill in. .env is git-ignored.
O2_EMAIL=you@example.com
O2_PASSWORD=your-o2-password

# Google credentials, from `python -m o2sync auth --print-env`.
# O2_GOOGLE_CLIENT_ID=
# O2_GOOGLE_CLIENT_SECRET=
# O2_GOOGLE_REFRESH_TOKEN=

# Which calendar to sync into. Needed only when the granted scopes cannot list
# calendars; get it from `python -m o2sync calendar-init`.
# O2_CALENDAR_ID=

# Set to make `sync` a long-running loop instead of a one-shot run.
# O2_SYNC_INTERVAL=6h
